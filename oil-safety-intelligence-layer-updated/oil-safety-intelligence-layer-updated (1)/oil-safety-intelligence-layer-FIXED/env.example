# Copy this file to .env.local and fill in the values printed by `npx convex dev`.
# `npx convex dev` usually writes .env.local for you automatically on first run.

# URL of your Convex deployment (printed by `npx convex dev`)
VITE_CONVEX_URL=http://127.0.0.1:3210
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211

# Convex Auth deployment variables (set automatically by npm run setup:auth)
# JWT_PRIVATE_KEY and JWKS are secrets and must NOT be committed.
